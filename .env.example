# =============================================================================
#  CompliGuard v2 — Example Environment File
#
#  DO NOT use values from this file in production. Run scripts/deploy.sh.
#  The placeholders below are intentionally invalid; deploy.sh generates
#  cryptographically random secrets and refuses to write weak values.
# =============================================================================

# ─── Required ─────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=__GENERATE_VIA_DEPLOY_SCRIPT__
JWT_SECRET=__GENERATE_VIA_DEPLOY_SCRIPT__
NEXTAUTH_URL=http://localhost:3030

# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=__GENERATE_VIA_DEPLOY_SCRIPT__
DATABASE_URL=postgresql://compliguard:__GENERATE_VIA_DEPLOY_SCRIPT__@localhost:5432/compliguard

# ─── MinIO (Object Storage) ───────────────────────────────────────────────────
MINIO_ROOT_USER=compliguard
MINIO_ROOT_PASSWORD=__GENERATE_VIA_DEPLOY_SCRIPT__
MINIO_ENDPOINT=http://localhost:9000

# ─── Storage Provider ─────────────────────────────────────────────────────────
STORAGE_PROVIDER=local   # local | s3 | azure_blob | onedrive | minio

# ─── Email Provider ───────────────────────────────────────────────────────────
EMAIL_PROVIDER=mock      # mock | postmark | smtp
POSTMARK_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=compliance@yourdomain.com

# ─── AI Provider ──────────────────────────────────────────────────────────────
AI_PROVIDER=openai       # openai | gemini | claude | ollama
OPENAI_API_KEY=
GEMINI_API_KEY=
CLAUDE_API_KEY=
OLLAMA_ENDPOINT=http://localhost:11434

# ─── Application ──────────────────────────────────────────────────────────────
PORT=3030
NODE_ENV=production
PLATFORM_NAME=CompliGuard
ALLOW_REGISTRATIONS=false

# ─── Optional: Redis ──────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

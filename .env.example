# ─── Required ─────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=your-32-char-secret-here-change-this
JWT_SECRET=your-32-char-jwt-secret-change-this
NEXTAUTH_URL=http://localhost:3030

# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=changeme-strong-password
DATABASE_URL=postgresql://compliguard:changeme-strong-password@localhost:5432/compliguard

# ─── MinIO (Object Storage) ───────────────────────────────────────────────────
MINIO_ROOT_USER=compliguard
MINIO_ROOT_PASSWORD=changeme-strong-password
MINIO_ENDPOINT=http://localhost:9000

# ─── Storage Provider ─────────────────────────────────────────────────────────
STORAGE_PROVIDER=local   # local | s3 | azure_blob | onedrive | minio

# ─── Email Provider ───────────────────────────────────────────────────────────
EMAIL_PROVIDER=mock      # mock | postmark | smtp
POSTMARK_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=compliance@yourdomain.com

# ─── AI Provider ──────────────────────────────────────────────────────────────
AI_PROVIDER=openai       # openai | gemini | claude | ollama
OPENAI_API_KEY=
GEMINI_API_KEY=
CLAUDE_API_KEY=
OLLAMA_ENDPOINT=http://localhost:11434

# ─── Application ──────────────────────────────────────────────────────────────
PORT=3030
NODE_ENV=production
PLATFORM_NAME=CompliGuard
ALLOW_REGISTRATIONS=false

# ─── Optional: Redis ──────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
